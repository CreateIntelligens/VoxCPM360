# --- VoxCPM Docker Deployment Environment Variables ---

# The ONLY port exposed to the outside host (unified access port)
PORT=8800

# Device settings: auto, cpu, cuda, or cuda:N (e.g. cuda:0)
VOXCPM_DEVICE=cuda

# Model ID: openbmb/VoxCPM2, or local path to models
MODEL_ID=openbmb/VoxCPM2

# Enable PyTorch model compilation (torch.compile) for faster inference
# Note: First inference will take 1-2 mins to compile the model.
VOXCPM_OPTIMIZE=false
