# 只列與 docker-compose.yml 預設不同的值；其餘留給 compose。

PORT=8800
# 留空停用 /api/v1/tts/* 的驗證，僅限本機開發。
TTS_API_KEY=

# 16GB 卡的調校組（預設值是給大顯存機器的）。
# VOXCPM_GPU_MEMORY_UTILIZATION=0.6
# VOXCPM_MAX_PENDING_SYNTHESIS=64
# VOXCPM_ENGINE_CONCURRENCY=16
# VOXCPM_INTERACTIVE_BATCH_MAX=16

# 關掉 CUDA Graph 捕獲，換取可讀的錯誤堆疊與較低顯存。
# VOXCPM_OPTIMIZE=false

# 退回 cu128 棧，五個變數缺一不可 —— wheel 綁定編譯當時的 torch ABI，
# 版本不符會在 import flash_attn 當場失敗。torchaudio 的版號自 2.12 起與
# torch 脫鉤（cu130 是 2.13.0 配 2.11.0），照 cu130 的直覺讓兩者同號會
# 設出不存在的組合，這裡的同號是 cu128 棧的實際值。
# aarch64 wheel 經 sha256 比對確認編譯於 torch 2.11.0+cu128；x86_64 為
# 同批產出，未獨立驗證。
# CUDA_BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu22.04
# TORCH_CUDA_VARIANT=cu128
# FLASH_ATTN_VERSION=2.6.3
# TORCH_VERSION=2.11.0
# TORCHAUDIO_VERSION=2.11.0

# 只編當前架構（A4000=8.6、GB10=12.0），建置時間約 1/3。
# 產出跨機通用 image 時務必留空。
# TORCH_ARCH_LIST=8.6
