# --- VoxCPM Docker Deployment Environment Variables ---

# The only host port exposed by the React/Nginx gateway.
PORT=8800

# Device settings: auto, cpu, cuda, or cuda:N (e.g. cuda:0).
VOXCPM_DEVICE=cuda

# Model ID: openbmb/VoxCPM2, or a local model path.
MODEL_ID=openbmb/VoxCPM2

# Nano-vLLM runtime settings.
VOXCPM_OPTIMIZE=false
VOXCPM_GPU_MEMORY_UTILIZATION=0.35
VOXCPM_PRELOAD=true
VOXCPM_MAX_PENDING_SYNTHESIS=2
VOXCPM_QUEUE_TIMEOUT_SECONDS=120
VOXCPM_MAX_GENERATE_LENGTH=2000
VOXCPM_MAX_AUDIO_TEXT_RATIO=6.0

# Same-model Batch requests use nano-vLLM continuous batching. The live chunk
# size is chosen from CUDA/cgroup memory headroom and never exceeds this max.
VOXCPM_BATCH_MAX_CONCURRENCY=16
VOXCPM_BATCH_MEMORY_RESERVE_GIB=2.0
VOXCPM_BATCH_MEMORY_PER_ITEM_GIB=1.5
VOXCPM_BATCH_MEMORY_MIN_PER_ITEM_GIB=0.5

# GB10/Grace-Blackwell 的 CUDA 13 組合（x86 留空走 compose 的 cu128 預設）。
CUDA_BASE_IMAGE=nvidia/cuda:13.0.3-cudnn-devel-ubuntu22.04
TORCH_CUDA_VARIANT=cu130
FLASH_ATTN_VERSION=2.8.3
TORCH_ARCH_LIST=12.0

# Model versions are discovered automatically from models/native and
# models/barbet. No per-version environment variables are required.

# Bearer token required by the CastAgent-compatible TTS endpoints
# (/api/v1/tts/voices, /api/v1/tts/synthesize). Leave blank to disable auth
# (local development only).
TTS_API_KEY=
