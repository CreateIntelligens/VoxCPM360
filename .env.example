# --- VoxCPM Docker Deployment Environment Variables ---

# The only host port exposed by the React/Nginx gateway.
PORT=8800

# Device settings: auto, cpu, cuda, or cuda:N (e.g. cuda:0).
VOXCPM_DEVICE=cuda

# Model ID: openbmb/VoxCPM2, or a local model path.
MODEL_ID=openbmb/VoxCPM2

# Nano-vLLM runtime settings.
VOXCPM_OPTIMIZE=false
VOXCPM_GPU_MEMORY_UTILIZATION=0.35
VOXCPM_PRELOAD=true

# A BlueMagpie backend running on the Docker host.
BLUEMAGPIE_URL=http://host.docker.internal:1981

# Model versions are discovered automatically from models/native and
# models/barbet. No per-version environment variables are required.
